rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity 1: UserProfile Validation Blueprint
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'phoneTag',
          'bio',
          'wallpaperTheme',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'phoneTag',
          'bio',
          'wallpaperTheme',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.phoneTag is string
        && data.phoneTag.size() >= 7
        && data.phoneTag.size() <= 20
        && data.phoneTag.matches('^[0-9+]+$')
        && data.bio is string
        && data.bio.size() <= 200
        && data.wallpaperTheme is string
        && data.wallpaperTheme.size() <= 40
        && (
          data.wallpaperTheme == 'aurora-borealis' ||
          data.wallpaperTheme == 'neon-waves' ||
          data.wallpaperTheme == 'cosmic-nebula' ||
          data.wallpaperTheme == 'sunset-liquid' ||
          data.wallpaperTheme == 'emerald-matrix' ||
          data.wallpaperTheme == 'royal-amethyst'
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Entity 2: SavedContact Validation Blueprint
    function isValidSavedContact(data) {
      return data.keys().hasAll([
          'ownerUid',
          'contactName',
          'contactPhone',
          'contactBio',
          'avatarFallbackColor',
          'isMuted',
          'isBlocked',
          'isPinned',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'contactName',
          'contactPhone',
          'contactBio',
          'avatarFallbackColor',
          'isMuted',
          'isBlocked',
          'isPinned',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid is string
        && data.ownerUid.size() >= 1
        && data.ownerUid.size() <= 128
        && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerUid == request.auth.uid
        && data.contactName is string
        && data.contactName.size() >= 1
        && data.contactName.size() <= 80
        && data.contactPhone is string
        && data.contactPhone.size() >= 7
        && data.contactPhone.size() <= 20
        && data.contactPhone.matches('^[0-9+]+$')
        && data.contactBio is string
        && data.contactBio.size() <= 200
        && data.avatarFallbackColor is string
        && data.avatarFallbackColor.size() >= 1
        && data.avatarFallbackColor.size() <= 40
        && data.isMuted is bool
        && data.isBlocked is bool
        && data.isPinned is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Entity 3: ChatMessage Validation Blueprint
    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'ownerUid',
          'contactId',
          'senderRole',
          'senderName',
          'text',
          'messageType',
          'displayTime',
          'isStarred',
          'isPinned',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'contactId',
          'senderRole',
          'senderName',
          'text',
          'messageType',
          'displayTime',
          'isStarred',
          'isPinned',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid is string
        && data.ownerUid.size() >= 1
        && data.ownerUid.size() <= 128
        && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerUid == request.auth.uid
        && data.contactId is string
        && data.contactId.size() >= 1
        && data.contactId.size() <= 128
        && data.contactId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.senderRole is string
        && data.senderRole.size() <= 20
        && (data.senderRole == 'me' || data.senderRole == 'contact')
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 80
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 2000
        && data.messageType is string
        && data.messageType.size() <= 20
        && (
          data.messageType == 'text' ||
          data.messageType == 'voice' ||
          data.messageType == 'image' ||
          data.messageType == 'file' ||
          data.messageType == 'poll'
        )
        && data.displayTime is string
        && data.displayTime.size() >= 1
        && data.displayTime.size() <= 40
        && data.isStarred is bool
        && data.isPinned is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Master Gate Helper 1: Verify Parent User Exists & Is Owned by Caller
    function isParentUserOwner(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // Master Gate Helper 2: Verify Parent Contact Exists & Is Owned by Caller
    function isParentContactOwner(userId, contactId) {
      return exists(/databases/$(database)/documents/users/$(userId)/contacts/$(contactId))
        && get(/databases/$(database)/documents/users/$(userId)/contacts/$(contactId)).data.ownerUid == request.auth.uid;
    }

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && existing().uid == request.auth.uid;

      allow list: if isSignedIn()
        && request.auth.uid == userId
        && existing().uid == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'phoneTag',
            'bio',
            'wallpaperTheme',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && existing().uid == request.auth.uid;

      // Subcollection 2: /users/{userId}/contacts/{contactId}
      match /contacts/{contactId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(contactId)
          && request.auth.uid == userId
          && existing().ownerUid == request.auth.uid
          && isParentUserOwner(userId);

        allow list: if isSignedIn()
          && request.auth.uid == userId
          && existing().ownerUid == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(contactId)
          && request.auth.uid == userId
          && isValidSavedContact(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isParentUserOwner(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(contactId)
          && request.auth.uid == userId
          && isValidSavedContact(incoming())
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isParentUserOwner(userId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'contactName',
              'contactBio',
              'isMuted',
              'isBlocked',
              'isPinned',
              'updatedAt'
            ])
          );

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(contactId)
          && request.auth.uid == userId
          && existing().ownerUid == request.auth.uid
          && isParentUserOwner(userId);

        // Subcollection 3: /users/{userId}/contacts/{contactId}/messages/{messageId}
        match /messages/{messageId} {
          allow get: if isSignedIn()
            && isValidId(userId)
            && isValidId(contactId)
            && isValidId(messageId)
            && request.auth.uid == userId
            && existing().ownerUid == request.auth.uid
            && isParentContactOwner(userId, contactId);

          allow list: if isSignedIn()
            && request.auth.uid == userId
            && existing().ownerUid == request.auth.uid;

          allow create: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(contactId)
            && isValidId(messageId)
            && request.auth.uid == userId
            && isValidChatMessage(incoming())
            && incoming().contactId == contactId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && isParentContactOwner(userId, contactId);

          allow update: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(contactId)
            && isValidId(messageId)
            && request.auth.uid == userId
            && isValidChatMessage(incoming())
            && incoming().ownerUid == existing().ownerUid
            && incoming().contactId == existing().contactId
            && incoming().senderRole == existing().senderRole
            && incoming().text == existing().text
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && isParentContactOwner(userId, contactId)
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'isStarred',
                'isPinned',
                'updatedAt'
              ])
            );

          allow delete: if isVerifiedUser()
            && isValidId(userId)
            && isValidId(contactId)
            && isValidId(messageId)
            && request.auth.uid == userId
            && existing().ownerUid == request.auth.uid
            && isParentContactOwner(userId, contactId);
        }
      }
    }
  }
}
