{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated owner-only user profile with PII (email and phoneTag) and verification state.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Full display name of the user.",
          "minLength": 1,
          "maxLength": 80
        },
        "username": {
          "type": "string",
          "description": "Unique lowercase username identifier.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$"
        },
        "email": {
          "type": "string",
          "description": "Registered email address (private to owner).",
          "minLength": 5,
          "maxLength": 120
        },
        "phoneTag": {
          "type": "string",
          "description": "E.164 phone number with country code (private to owner).",
          "minLength": 7,
          "maxLength": 20,
          "pattern": "^[0-9+]+$"
        },
        "bio": {
          "type": "string",
          "description": "Personal status or bio text.",
          "minLength": 0,
          "maxLength": 200
        },
        "wallpaperTheme": {
          "type": "string",
          "description": "Selected animated wallpaper theme ID.",
          "enum": [
            "aurora-borealis",
            "neon-waves",
            "cosmic-nebula",
            "sunset-liquid",
            "emerald-matrix",
            "royal-amethyst"
          ]
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the user's email has been verified via Firebase Auth."
        },
        "phoneVerified": {
          "type": "boolean",
          "description": "Whether the user's phone number has been verified via Firebase Phone Auth OTP."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "username",
        "email",
        "phoneTag",
        "bio",
        "wallpaperTheme",
        "emailVerified",
        "phoneVerified",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicDirectoryProfile": {
      "title": "PublicDirectoryProfile",
      "description": "Public non-PII profile indexed by Firebase Auth UID for user search and chat verification.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Unique lowercase username.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "description": "Public bio text.",
          "minLength": 0,
          "maxLength": 200
        },
        "avatarFallbackColor": {
          "type": "string",
          "description": "Avatar badge or color class.",
          "minLength": 1,
          "maxLength": 40
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the user has verified their email."
        },
        "phoneVerified": {
          "type": "boolean",
          "description": "Whether the user has verified their phone number via SMS OTP."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "username",
        "displayName",
        "bio",
        "avatarFallbackColor",
        "emailVerified",
        "phoneVerified",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Atomic unique username registry mapping a unique lowercase username to a Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID that owns this username.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Normalized unique username matching document ID.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name of the user.",
          "minLength": 1,
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "description": "Public bio or status.",
          "minLength": 0,
          "maxLength": 200
        },
        "avatarFallbackColor": {
          "type": "string",
          "description": "Avatar fallback color identifier.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "username",
        "displayName",
        "bio",
        "avatarFallbackColor",
        "createdAt",
        "updatedAt"
      ]
    },
    "PhoneSearchEntry": {
      "title": "PhoneSearchEntry",
      "description": "Public non-PII phone lookup index mapping a normalized E.164 phone number to a Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID that added this phone number.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "phoneKey": {
          "type": "string",
          "description": "Normalized E.164 phone number matching document ID.",
          "minLength": 7,
          "maxLength": 20,
          "pattern": "^\\+[1-9][0-9]{6,18}$"
        },
        "username": {
          "type": "string",
          "description": "Normalized unique username of the user.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name of the user.",
          "minLength": 1,
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "description": "Public bio or status.",
          "minLength": 0,
          "maxLength": 200
        },
        "avatarFallbackColor": {
          "type": "string",
          "description": "Avatar fallback color identifier.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "phoneKey",
        "username",
        "displayName",
        "bio",
        "avatarFallbackColor",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "A direct conversation room between two verified, registered Firebase UIDs.",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "description": "Deterministic chat ID formed from participant UIDs.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantOneUid": {
          "type": "string",
          "description": "Firebase Auth UID of the first participant.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantTwoUid": {
          "type": "string",
          "description": "Firebase Auth UID of the second participant.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantOneName": {
          "type": "string",
          "description": "Display name of the first participant.",
          "minLength": 1,
          "maxLength": 80
        },
        "participantTwoName": {
          "type": "string",
          "description": "Display name of the second participant.",
          "minLength": 1,
          "maxLength": 80
        },
        "participantOneUsername": {
          "type": "string",
          "description": "Unique username of the first participant.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$"
        },
        "participantTwoUsername": {
          "type": "string",
          "description": "Unique username of the second participant.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$"
        },
        "createdByUid": {
          "type": "string",
          "description": "UID of the participant who initiated the chat.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastMessageText": {
          "type": "string",
          "description": "Preview of the most recent message.",
          "minLength": 1,
          "maxLength": 500
        },
        "lastMessageSenderUid": {
          "type": "string",
          "description": "UID of the sender of the most recent message.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastMessageTime": {
          "type": "string",
          "description": "Formatted time of the last message.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "chatId",
        "participantOneUid",
        "participantTwoUid",
        "participantOneName",
        "participantTwoName",
        "participantOneUsername",
        "participantTwoUsername",
        "createdByUid",
        "lastMessageText",
        "lastMessageSenderUid",
        "lastMessageTime",
        "createdAt",
        "updatedAt"
      ]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "A real-time message inside an authorized ChatRoom between two registered UIDs.",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "description": "Parent ChatRoom document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "description": "Firebase Auth UID of the message sender.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientUid": {
          "type": "string",
          "description": "Firebase Auth UID of the message recipient.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender.",
          "minLength": 1,
          "maxLength": 80
        },
        "senderUsername": {
          "type": "string",
          "description": "Username of the sender.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$"
        },
        "text": {
          "type": "string",
          "description": "Message text content.",
          "minLength": 1,
          "maxLength": 2000
        },
        "messageType": {
          "type": "string",
          "description": "Type of message.",
          "enum": ["text", "voice", "image", "file", "poll", "sticker"]
        },
        "displayTime": {
          "type": "string",
          "description": "Formatted time string.",
          "minLength": 1,
          "maxLength": 40
        },
        "isStarred": {
          "type": "boolean",
          "description": "Whether the message is starred."
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the message is pinned."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "chatId",
        "senderUid",
        "recipientUid",
        "senderName",
        "senderUsername",
        "text",
        "messageType",
        "displayTime",
        "isStarred",
        "isPinned",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedContact": {
      "title": "SavedContact",
      "description": "A contact conversation saved under a user's workspace with mute, block, and wallpaper settings.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "UID of the user who owns this contact record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "contactName": {
          "type": "string",
          "description": "Display name of the contact.",
          "minLength": 1,
          "maxLength": 80
        },
        "contactPhone": {
          "type": "string",
          "description": "Registered phone number of the contact.",
          "minLength": 7,
          "maxLength": 20,
          "pattern": "^[0-9+]+$"
        },
        "contactBio": {
          "type": "string",
          "description": "Bio or status text of the contact.",
          "minLength": 0,
          "maxLength": 200
        },
        "avatarFallbackColor": {
          "type": "string",
          "description": "Tailwind background class for avatar fallback.",
          "minLength": 1,
          "maxLength": 40
        },
        "isMuted": {
          "type": "boolean",
          "description": "Whether notifications for this contact are muted."
        },
        "isBlocked": {
          "type": "boolean",
          "description": "Whether this contact is blocked."
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether this contact is pinned in the sidebar."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerUid",
        "contactName",
        "contactPhone",
        "contactBio",
        "avatarFallbackColor",
        "isMuted",
        "isBlocked",
        "isPinned",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A chat message persisted inside a contact conversation.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "UID of the user who owns this conversation.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "contactId": {
          "type": "string",
          "description": "Parent contact document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderRole": {
          "type": "string",
          "description": "Whether the message was sent by 'me' or 'contact'.",
          "enum": ["me", "contact"]
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender.",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "description": "Message text content.",
          "minLength": 1,
          "maxLength": 2000
        },
        "messageType": {
          "type": "string",
          "description": "Message type.",
          "enum": ["text", "voice", "image", "file", "poll", "sticker"]
        },
        "displayTime": {
          "type": "string",
          "description": "Formatted display timestamp string.",
          "minLength": 1,
          "maxLength": 40
        },
        "isStarred": {
          "type": "boolean",
          "description": "Whether the message is starred."
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the message is pinned."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerUid",
        "contactId",
        "senderRole",
        "senderName",
        "text",
        "messageType",
        "displayTime",
        "isStarred",
        "isPinned",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores isolated private user profile and PII (email, phoneTag) accessible strictly by the owner."
    },
    "/directory/{userId}": {
      "schema": { "$ref": "#/entities/PublicDirectoryProfile" },
      "description": "Stores public non-PII profile indexed by Firebase UID for verified user lookup."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Enforces atomic username uniqueness and maps @username to a registered Firebase UID."
    },
    "/phone_index/{phoneKey}": {
      "schema": { "$ref": "#/entities/PhoneSearchEntry" },
      "description": "Maps a normalized E.164 phone number to a registered Firebase UID for point lookup without public enumeration."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatRoom" },
      "description": "Stores 1-on-1 chat rooms between two real registered UIDs; accessible only to the two participants."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Stores real-time direct messages inside a chat room; accessible only to the two authorized participants."
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/SavedContact" },
      "description": "Stores the user's contacts, mute state, block state, and pin state."
    },
    "/users/{userId}/contacts/{contactId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Stores messages within a specific contact conversation."
    }
  }
}
